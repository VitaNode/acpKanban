#!/usr/bin/expect -f
set timeout -1
set log_file [lindex $argv 0]
set fifo_path [lindex $argv 1]

log_file $log_file

spawn gcloud auth login --no-launch-browser

# Wait for the prompt and URL
expect "https://accounts.google.com/o/oauth2/auth?" {
    # It's already showing the URL in the output
}

expect "enter the verification code provided in your browser:"

# Now wait for input from the FIFO
set fp [open $fifo_path r]
gets $fp code
close $fp

# Send the code
send "$code\r"

# Wait for completion
expect {
    "You are now logged in as" {
        send_user "\nLogin successful!\n"
    }
    timeout {
        send_user "\nLogin timed out.\n"
    }
}
